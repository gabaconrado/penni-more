{
  "description": "Lint files after Codex writes or edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/lint.sh\"",
            "timeout": 180,
            "statusMessage": "Linting repository files"
          }
        ]
      }
    ]
  }
}
