FROM docker.io/library/node:26.7.0-bookworm-slim AS web-build
WORKDIR /build/src/web
COPY src/web/package.json src/web/package-lock.json ./
RUN npm ci
COPY src/web/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv

FROM docker.io/library/python:3.14.7-slim-bookworm AS python-dependencies
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app/src/backend
COPY src/backend/pyproject.toml src/backend/uv.lock ./
RUN uv sync --frozen --no-dev

FROM python-dependencies AS static-collection
COPY src/backend/ /app/src/backend/
COPY src/web/templates/ /app/src/web/templates/
COPY --from=web-build /build/src/web/static/ /app/src/web/static/
RUN DJANGO_SETTINGS_MODULE=penni_more.settings.local \
    uv run --no-dev python manage.py collectstatic --noinput

FROM docker.io/library/python:3.14.7-slim-bookworm AS application
ENV PATH=/app/.venv/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN groupadd --system --gid 10001 penni-more \
    && useradd --system --uid 10001 --gid penni-more --home-dir /nonexistent penni-more
WORKDIR /app/src/backend
COPY --from=python-dependencies /app/.venv /app/.venv
COPY src/backend/ ./
COPY src/web/templates/ /app/src/web/templates/
COPY --from=web-build /build/src/web/static/ /app/src/web/static/
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=1", "--threads=4", "penni_more.wsgi:application"]

FROM docker.io/library/nginx:1.29.1-alpine AS nginx
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/templates/default.conf.template /etc/nginx/default.conf.template
COPY deploy/nginx/entrypoint.sh /usr/local/bin/penni-more-nginx-entrypoint
COPY --from=static-collection /app/src/backend/staticfiles/ /srv/static/
RUN chmod 0755 /usr/local/bin/penni-more-nginx-entrypoint
USER 101:101
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/penni-more-nginx-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
