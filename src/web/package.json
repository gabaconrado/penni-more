{
  "name": "penni-more-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./tailwind.css -o ./static/css/app.css --minify",
    "format": "prettier --write tailwind.css *.config.js tests/**/*.js",
    "format:check": "prettier --check tailwind.css *.config.js tests/**/*.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.21",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "26.7.0"
  }
}
